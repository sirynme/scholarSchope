# ScholarScope — Environment Configuration
# Copy to .env for local or production deployment. Never commit real secrets.

# Database (PostgreSQL on Neon / Vercel Postgres / Supabase for production; falls back to local JSON store only in local dev)
# Pooled connection string for serverless runtime queries (@prisma/adapter-pg + pg.Pool)
DATABASE_URL="postgresql://user:password@ep-scholarscope-pooler.us-east-2.aws.neon.tech/scholarscope?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection string for Prisma schema migrations (npx prisma migrate deploy)
DIRECT_URL="postgresql://user:password@ep-scholarscope.us-east-2.aws.neon.tech/scholarscope?sslmode=require"
PG_POOL_MAX="5"

# Authentication & Session Security
SESSION_SECRET="replace-with-32-byte-cryptographic-session-secret"

# Vercel Cron & Scheduler Authentication (Required in serverless production for GET/POST /api/cron/daily-research)
CRON_SECRET="scholarscope-cron-secret-key-2026"

# Optional Email Delivery (Resend — disabled by default until configured)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@scholarscope.org"

# Optional AI & Search Grounding (Disabled by default per Section 3 Provider Policy)
# AI Studio automatically injects GEMINI_API_KEY at runtime when enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ENABLE_OPTIONAL_AI_PROVIDERS="false"

# Application Base URL
APP_URL="http://localhost:3000"
